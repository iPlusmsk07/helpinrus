# Copy to /etc/helpinrus/auth.env. The installer generates APP_SECRET itself.
HELPINRUS_ENV=production
BIND_HOST=127.0.0.1
BIND_PORT=8787
DATABASE_PATH=/var/lib/helpinrus/auth.sqlite3
PUBLIC_ORIGIN=https://201.51.4.212
ALLOWED_ORIGINS=https://201.51.4.212
APP_SECRET=
COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-pomogay_session
SESSION_TTL_SECONDS=2592000
SIGNUP_TTL_SECONDS=86400
RESET_TTL_SECONDS=1800
SCRYPT_N=32768
SCRYPT_R=8
SCRYPT_P=1

# Signup and password reset remain intentionally unavailable until a real SMTP
# sender is configured. Use a transactional provider with SPF/DKIM, not direct
# delivery from the server IP.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=15
