[Unit]
Description=Helpinrus same-origin authentication API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helpinrus
Group=helpinrus
WorkingDirectory=/opt/helpinrus
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/helpinrus/auth.env
ExecStartPre=/usr/bin/python3 -m server.manage migrate
ExecStart=/usr/bin/python3 -m server.main
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/helpinrus
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
