#!/usr/bin/env bash
set -Eeuo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root." >&2
  exit 1
fi

environment=/etc/helpinrus/auth.env
repo=/opt/helpinrus

if [ ! -f "$environment" ]; then
  echo "Install the authentication backend first: $environment is missing." >&2
  exit 1
fi

printf 'Gmail address used to send Helpinrus messages: '
IFS= read -r smtp_email
if [[ ! "$smtp_email" =~ ^[^[:space:]@]+@gmail\.com$ ]]; then
  echo "Enter a valid @gmail.com address." >&2
  exit 2
fi

printf 'Google app password (hidden, 16 characters): '
IFS= read -rs smtp_password
printf '\n'
smtp_password=${smtp_password//[[:space:]]/}
if [[ ! "$smtp_password" =~ ^[A-Za-z0-9]{16}$ ]]; then
  unset smtp_password
  echo "Use a 16-character Google app password, not the account password." >&2
  exit 2
fi

temporary=$(mktemp "${environment}.tmp.XXXXXX")
cleanup() {
  unset smtp_password
  rm -f -- "$temporary"
}
trap cleanup EXIT INT TERM

host_seen=0
port_seen=0
mode_seen=0
username_seen=0
password_seen=0
from_seen=0
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    SMTP_HOST=*) printf 'SMTP_HOST=smtp.gmail.com\n'; host_seen=1 ;;
    SMTP_PORT=*) printf 'SMTP_PORT=587\n'; port_seen=1 ;;
    SMTP_MODE=*) printf 'SMTP_MODE=starttls\n'; mode_seen=1 ;;
    SMTP_USERNAME=*) printf 'SMTP_USERNAME=%s\n' "$smtp_email"; username_seen=1 ;;
    SMTP_PASSWORD=*) printf 'SMTP_PASSWORD=%s\n' "$smtp_password"; password_seen=1 ;;
    SMTP_FROM=*) printf 'SMTP_FROM=%s\n' "$smtp_email"; from_seen=1 ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$environment" > "$temporary"

[ "$host_seen" -eq 1 ] || printf 'SMTP_HOST=smtp.gmail.com\n' >> "$temporary"
[ "$port_seen" -eq 1 ] || printf 'SMTP_PORT=587\n' >> "$temporary"
[ "$mode_seen" -eq 1 ] || printf 'SMTP_MODE=starttls\n' >> "$temporary"
[ "$username_seen" -eq 1 ] || printf 'SMTP_USERNAME=%s\n' "$smtp_email" >> "$temporary"
[ "$password_seen" -eq 1 ] || printf 'SMTP_PASSWORD=%s\n' "$smtp_password" >> "$temporary"
[ "$from_seen" -eq 1 ] || printf 'SMTP_FROM=%s\n' "$smtp_email" >> "$temporary"

chown --reference="$environment" "$temporary"
chmod --reference="$environment" "$temporary"
mv -f -- "$temporary" "$environment"
trap - EXIT INT TERM
unset smtp_password

systemctl restart helpinrus-auth.service
/usr/sbin/runuser -u helpinrus -- /bin/sh -c \
  'set -a; . /etc/helpinrus/auth.env; set +a; cd /opt/helpinrus; python3 -m server.manage smtp-check'
curl --fail --silent --show-error \
  --connect-timeout 2 --max-time 5 \
  http://127.0.0.1:8787/api/auth/health
echo
echo "Gmail SMTP is configured. Complete a real password-reset delivery test before release."
